{
	email {$ACME_EMAIL}
	metrics {
		per_host
	}
	servers {
		# Cloudflare published ranges, checked 2026-10-22: https://www.cloudflare.com/ips/
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

(access_log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri regexp "[?].*" ""
				request>remote_ip delete
				request>remote_port delete
				request>tls delete
				resp_headers delete
				user_id delete
			}
		}
	}
}

(private_metrics) {
	@private_metrics path /metrics /metrics/*
	respond @private_metrics 404
}

(vpn_only) {
	@outside_vpn not remote_ip 10.77.0.0/24
	respond @outside_vpn 404
}

:9180 {
	metrics /metrics
}

{$WEBSITE_DOMAIN} {
	import access_log
	reverse_proxy papyrus-website:8080
}

www.{$WEBSITE_DOMAIN} {
	import access_log
	redir https://{$WEBSITE_DOMAIN}{uri} permanent
}

{$APP_DOMAIN} {
	import access_log
	reverse_proxy papyrus-app:8080
}

{$API_DOMAIN} {
	import access_log
	reverse_proxy papyrus-api:8080
}

{$SYNC_DOMAIN} {
	import access_log
	reverse_proxy papyrus-sync:8080
}

monitor.{$WEBSITE_DOMAIN} {
	import access_log
	import vpn_only
	import private_metrics
	reverse_proxy papyrus-grafana:3000
}
